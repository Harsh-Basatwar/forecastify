{
  "manifest_version": 3,
  "name": "Arjuna Sarthi AI",
  "description": "AI-powered procurement assistant that bridges inventory forecasting with product purchasing on supplier platforms.",
  "version": "1.0.0",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Forecastify Procurement"
  },
  "icons": {
    "16": "icons/extension.png",
    "48": "icons/extension.png",
    "128": "icons/extension.png"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.tsx-loader-KoS5BXsb.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "src/content/content.css"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "icons/*",
        "assets/jsx-runtime-CFCE4xZu.js",
        "assets/index.tsx-LuLFx3la.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
